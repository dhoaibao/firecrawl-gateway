# Firecrawl Gateway
# Copy to .env and configure the external services:
#   cp .env.example .env

# ----------------------------------------------------------------------------
# Upstreams and routing are configured in the Admin UI under Configure.
# The gateway defaults to cloud-first until a different route mode is saved.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------

GATEWAY_PORT=8080
# Prebuilt Compose only: pin to a release digest, never use :latest.
GATEWAY_IMAGE=dhoaibao/firecrawl-gateway@sha256:replace-with-release-digest
AUDIT_RETENTION_DAYS=90
# Compose defaults to production. Set to development only for local HTTP use.
NODE_ENV=production
GATEWAY_REQUEST_TIMEOUT_MS=120000
# Local compatibility output only; production audit events use PostgreSQL.
GATEWAY_LOG_FILE=/tmp/hybrid-firecrawl-requests.jsonl
GATEWAY_MAX_BODY_BYTES=5242880
# Operator policy: maximum lifetime for user-created gateway tokens.
GATEWAY_TOKEN_MAX_LIFETIME_DAYS=365
LOG_LEVEL=info
# API deployments set false; the dedicated worker sets true.
WORKER_ENABLED=true
WORKER_HEARTBEAT_FILE=/tmp/firecrawl-worker-heartbeat

# ----------------------------------------------------------------------------
# Authentication and admin
# ----------------------------------------------------------------------------

AUTH_ENABLED=true
CORS_ORIGIN=
TRUST_PROXY=false
# Set NODE_ENV=development and SESSION_SECURE=false only for local HTTP use.
SESSION_SECURE=
SESSION_SECRET=change-me-to-a-long-random-string
# Canonical public URL used in verification and recovery links; never inferred from request headers.
PUBLIC_APP_URL=https://gateway.example.com
CLOUD_BASE_URL=https://api.firecrawl.dev
# Separate 64-character hex key used to encrypt MFA secrets and short-lived email payloads.
AUTH_ENCRYPTION_KEY=replace-with-64-character-hex-key
# Legacy 64-character hex key used to decrypt the pre-Phase-4 Cloud-key setting.
# Keep stable until `sources:convert-legacy` has completed.
FIRECRAWL_KEYS_ENCRYPTION_KEY=replace-with-64-character-hex-key
# Independent 64-character hex vault key for provider credentials. Do not reuse
# SESSION_SECRET or AUTH_ENCRYPTION_KEY. Generate with: openssl rand -hex 32
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-different-64-character-hex-key
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
REGISTRATION_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Firecrawl Gateway
BREVO_WEBHOOK_TOKEN=

# PostgreSQL database managed outside this Compose stack.
DATABASE_URL=postgresql://runtime_user:password@postgres.example.com:5432/firecrawl_gateway
# Separate operator credential used only for cross-tenant maintenance transactions.
OPERATOR_DATABASE_URL=postgresql://operator_user:password@postgres.example.com:5432/firecrawl_gateway
# Deployment-only schema/security credential; do not use this for the API runtime or operator pool.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@postgres.example.com:5432/firecrawl_gateway
