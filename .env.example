# Firecrawl Gateway monorepo
# API (long-running Node server) and Admin (static SPA) are deployed separately.

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------

PORT=8080
API_REQUEST_TIMEOUT_MS=120000
# Self-hosted circuit breaker: this many consecutive failures (connection error,
# timeout, 502/503/504) fail self-hosted calls fast for the cooldown, then one
# probe request is let through. 0 disables the breaker.
SELF_HOSTED_BREAKER_FAILURE_THRESHOLD=5
SELF_HOSTED_BREAKER_COOLDOWN_MS=30000
API_MAX_BODY_BYTES=5242880
LOG_LEVEL=info

# Self-hosted Firecrawl from deploy/firecrawl/docker-compose.yml. The gateway calls
# it directly; there is no admin setting for it. Defaults to the Compose stack's
# loopback port. Change it only when the stack is reachable at another address.
FIRECRAWL_SELF_HOSTED_URL=http://127.0.0.1:3002

# Exact browser origins. Do not use a wildcard when credentials are enabled.
API_ORIGIN=https://api.example.com
ADMIN_ORIGIN=https://admin.example.com

AUTH_ENABLED=true
TRUST_PROXY=false
SESSION_SECRET=replace-with-a-long-random-secret
# Marks the admin session cookie Secure. Leave unset to follow NODE_ENV
# (Secure in production); set false only for plain-HTTP local use.
# SESSION_SECURE=
# 64-character hex key used to encrypt Firecrawl Cloud API keys in PostgreSQL.
# Generate with: openssl rand -hex 32
FIRECRAWL_KEYS_ENCRYPTION_KEY=replace-with-64-character-hex-key
# The single admin identity is read from these variables at login time.
# Changing them replaces the only accepted credentials; restart/redeploy the API.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# GET /api/cron/maintenance must be called daily with
# Authorization: Bearer <CRON_SECRET>; the deploy/gateway `maintenance` service
# does this in the Docker deployment.
CRON_SECRET=replace-with-a-cron-secret

# Optional. When set (at least 16 characters), Prometheus can scrape
# GET /admin/api/metrics with Authorization: Bearer <METRICS_TOKEN>. Leave empty
# to disable the endpoint (it then answers 404).
METRICS_TOKEN=

# PostgreSQL managed outside this repository. The same URL is used by the
# runtime and `bun run db:migrate`; it must be a migration-capable direct
# PostgreSQL connection, not a transaction-only PgBouncer endpoint.
DATABASE_URL=postgresql://user:password@postgres.example.com:5432/firecrawl_gateway

# Optional Redis TCP URL used for the shared estimated-credit ledger. Redis
# stores only HMAC-derived opaque key identifiers, never Firecrawl API keys.
# Leave empty to use safe per-instance key rotation without shared reservations.
REDIS_URL=

# ----------------------------------------------------------------------------
# Admin Vite project
# ----------------------------------------------------------------------------

VITE_API_BASE_URL=https://api.example.com
