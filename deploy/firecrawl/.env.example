# Compose variables for deploy/firecrawl/docker-compose.yml.
# Copy to .env in this directory. Not the API's .env (see ../../.env.example).

# Pin one release; the compose file targets the published GHCR image tags.
FIRECRAWL_VERSION=2.11.489
PLAYWRIGHT_SERVICE_VERSION=latest
NUQ_POSTGRES_VERSION=latest

# Host binding. Firecrawl runs unauthenticated, so keep 127.0.0.1 unless a
# firewall, private network, or authenticating reverse proxy protects the port.
FIRECRAWL_BIND_ADDRESS=127.0.0.1
FIRECRAWL_PORT=3002

# Internal-only Postgres credentials (the database is not published).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Sizing preset. Active values fit a ~4 GB host (~2.4 GB in use at idle).
# For a bigger machine, replace this block with one of the presets below.
# The api container runs 8 Node processes plus a harness: measured ~1.7 GiB
# steady (1.8 GiB peak at startup) with 1 worker, ~2.7 GiB (3.0 peak) with 4,
# so an API_MEM_LIMIT of 2g or less crash-loops. Other limits are estimates;
# check `docker stats`.
NUQ_WORKER_COUNT=1
PLAYWRIGHT_MAX_CONCURRENT_PAGES=1
API_CPUS=2.0
API_MEM_LIMIT=2560m
PLAYWRIGHT_CPUS=1.0
PLAYWRIGHT_MEM_LIMIT=768m
PLAYWRIGHT_TMPFS_SIZE=128m
RABBITMQ_MEM_LIMIT=384m
POSTGRES_MEM_LIMIT=192m
REDIS_MEM_LIMIT=64m
REDIS_MAXMEMORY=32mb

# --- ~6 GB preset (api limit extrapolated from the 1- and 4-worker runs) ---
# NUQ_WORKER_COUNT=2
# PLAYWRIGHT_MAX_CONCURRENT_PAGES=3
# API_CPUS=2.0
# API_MEM_LIMIT=3g
# PLAYWRIGHT_CPUS=2.0
# PLAYWRIGHT_MEM_LIMIT=1g
# PLAYWRIGHT_TMPFS_SIZE=256m
# RABBITMQ_MEM_LIMIT=384m
# POSTGRES_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=96m
# REDIS_MAXMEMORY=64mb

# --- ~8 GB preset (api limit measured with 4 workers: 3.0 GiB peak) ---
# NUQ_WORKER_COUNT=4
# PLAYWRIGHT_MAX_CONCURRENT_PAGES=5
# API_CPUS=2.0
# API_MEM_LIMIT=4g
# PLAYWRIGHT_CPUS=2.0
# PLAYWRIGHT_MEM_LIMIT=1536m
# PLAYWRIGHT_TMPFS_SIZE=256m
# RABBITMQ_MEM_LIMIT=512m
# POSTGRES_MEM_LIMIT=384m
# REDIS_MEM_LIMIT=128m
# REDIS_MAXMEMORY=96mb

# Optional.
LOGGING_LEVEL=info
BULL_AUTH_KEY=
BLOCK_MEDIA=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
