# Server .env for deploy/gateway/docker-compose.yml. In CI this is the ENV_FILE
# secret; the workflow appends IMAGE_PREFIX and IMAGE_TAG. Never commit real values.

PORT=8080
LOG_LEVEL=info

# One public HTTPS origin serves both the admin and the API.
API_ORIGIN=https://gateway.example.com
ADMIN_ORIGIN=https://gateway.example.com
AUTH_ENABLED=true
# The host nginx and the web container sit in front of the API.
TRUST_PROXY=true

SESSION_SECRET=replace-with-a-long-random-secret
# openssl rand -hex 32
FIRECRAWL_KEYS_ENCRYPTION_KEY=replace-with-64-character-hex-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Customer portal sign-in (optional). Leave every value empty to keep the portal
# API disabled. Configuring a provider requires API_ORIGIN, PORTAL_ORIGIN and
# SESSION_SECRET. Register {API_ORIGIN}/portal/api/auth/callback/google (or
# /github) as the provider's redirect URI.
PORTAL_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=replace-with-a-cron-secret
# Optional: at least 16 characters enables GET /admin/api/metrics for Prometheus
# (Authorization: Bearer <METRICS_TOKEN>). Empty keeps the endpoint disabled (404).
METRICS_TOKEN=
# Memory bound of the response cache in bytes. Its TTL and the Telegram alert
# settings are configured on the admin Configure page, not here.
RESPONSE_CACHE_MAX_BYTES=67108864

# Migration-capable direct PostgreSQL URL managed outside this repository.
DATABASE_URL=postgresql://user:password@postgres.example.com:5432/firecrawl_gateway
REDIS_URL=

# Self-hosted Firecrawl from deploy/firecrawl, reached over its Docker network.
FIRECRAWL_SELF_HOSTED_URL=http://api:3002
# Name of that stack's network (compose project "firecrawl" + network "backend").
FIRECRAWL_NETWORK=firecrawl_backend

# Host port the web container publishes on 127.0.0.1 (the host nginx proxies here).
WEB_PORT=8080

# Run the customer portal container (compose profile). Remove to deploy without it.
COMPOSE_PROFILES=portal
# Customer portal container: the port it publishes on 127.0.0.1 and the origin of the
# gateway API it calls (the same value as API_ORIGIN; leave empty if the portal is
# served from the API's own origin). Put the portal on a host under the same site as
# the API so its session cookie is sent.
PORTAL_PORT=8081
PORTAL_API_BASE_URL=

# Manual runs only; the workflow sets these.
# IMAGE_PREFIX=ghcr.io/owner/repo
# IMAGE_TAG=sha-abc1234
