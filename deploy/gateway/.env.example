# Server .env for deploy/gateway/docker-compose.yml. In CI this is the ENV_FILE
# secret; the workflow appends IMAGE_PREFIX and IMAGE_TAG. Never commit real values.

PORT=8080
LOG_LEVEL=info

# One public HTTPS origin serves both the admin and the API.
API_ORIGIN=https://gateway.example.com
ADMIN_ORIGIN=https://gateway.example.com
AUTH_ENABLED=true
# The host nginx and the web container sit in front of the API.
TRUST_PROXY=true

SESSION_SECRET=replace-with-a-long-random-secret
# openssl rand -hex 32
FIRECRAWL_KEYS_ENCRYPTION_KEY=replace-with-64-character-hex-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
CRON_SECRET=replace-with-a-cron-secret

# Migration-capable direct PostgreSQL URL managed outside this repository.
DATABASE_URL=postgresql://user:password@postgres.example.com:5432/firecrawl_gateway
REDIS_URL=

# Self-hosted Firecrawl from deploy/firecrawl, reached over its Docker network.
FIRECRAWL_SELF_HOSTED_URL=http://api:3002
# Name of that stack's network (compose project "firecrawl" + network "backend").
FIRECRAWL_NETWORK=firecrawl_backend

# Host port the web container publishes on 127.0.0.1 (the host nginx proxies here).
WEB_PORT=8080

# Manual runs only; the workflow sets these.
# IMAGE_PREFIX=ghcr.io/owner/repo
# IMAGE_TAG=sha-abc1234
