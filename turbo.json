{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalPassThroughEnv": [
    "PORT",
    "FIRECRAWL_CLOUD_BASE_URL",
    "FIRECRAWL_SELF_HOSTED_URL",
    "API_REQUEST_TIMEOUT_MS",
    "SELF_HOSTED_BREAKER_FAILURE_THRESHOLD",
    "SELF_HOSTED_BREAKER_COOLDOWN_MS",
    "GATEWAY_REQUEST_TIMEOUT_MS",
    "API_MAX_BODY_BYTES",
    "GATEWAY_MAX_BODY_BYTES",
    "AUTH_ENABLED",
    "DATABASE_URL",
    "SESSION_SECRET",
    "SESSION_SECURE",
    "FIRECRAWL_KEYS_ENCRYPTION_KEY",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_ORIGIN",
    "API_ORIGIN",
    "PORTAL_ORIGIN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "TRUST_PROXY",
    "LOG_LEVEL",
    "CRON_SECRET",
    "METRICS_TOKEN",
    "RESPONSE_CACHE_MAX_BYTES",
    "REDIS_URL",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
