---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

// The portal's address is not known at build time: the container replaces this
// placeholder when it starts (deploy/landing/40-landing-config.sh).
const portalUrl = import.meta.env.DEV
  ? (import.meta.env.PUBLIC_PORTAL_URL ?? "http://localhost:5174")
  : "__PORTAL_URL__";

// What Firecrawl itself does. These are Firecrawl's features; the gateway forwards them.
const firecrawl = [
  {
    icon: "file",
    verb: "scrape",
    detail: "One URL in, clean markdown, HTML or structured JSON out.",
  },
  {
    icon: "network",
    verb: "crawl",
    detail: "Follow the links of a whole site and collect every page.",
  },
  {
    icon: "map",
    verb: "map",
    detail: "List the URLs a site exposes before you decide what to fetch.",
  },
  {
    icon: "search",
    verb: "search",
    detail: "Search the web and get the content of each result, not just links.",
  },
] as const;

const stats = [
  { value: "10", label: "gateway keys per account, each revocable on its own" },
  { value: "120", label: "requests per minute per key by default" },
  { value: "30", label: "days of request history kept, with usage per key" },
];

const flow = [
  {
    label: "Your app",
    title: "Sends the request",
    lines: ["Same request shape as Firecrawl", "Authenticates with a gateway key"],
  },
  {
    label: "Gateway",
    title: "Checks and counts it",
    lines: [
      "Verifies the key and its expiry",
      "Applies the key's rate limit",
      "Records usage for you",
    ],
    highlight: true,
  },
  {
    label: "Firecrawl Cloud",
    title: "Runs it on your key",
    lines: ["Uses your own Firecrawl key", "Spends your own credits"],
  },
];

const steps = [
  {
    title: "Sign in",
    body: "Use your Google or GitHub account. There is no password to manage and no card to enter.",
  },
  {
    title: "Add your Firecrawl Cloud key",
    body: "Paste a key from your own Firecrawl account. It is checked with Firecrawl before it is saved, stored encrypted, and never shown again.",
  },
  {
    title: "Create a gateway key and call the API",
    body: "Send requests to the gateway with that key as a Bearer token. They run on your Firecrawl account, so they use your credits.",
  },
];

const capabilities = [
  {
    icon: "key",
    term: "One endpoint, your credentials",
    detail:
      "Point Firecrawl-compatible clients at the gateway's /v1 and /v2 routes and authenticate with a gateway key instead of handing out your Firecrawl key.",
  },
  {
    icon: "clock",
    term: "Keys you can revoke",
    detail:
      "Create up to 10 gateway keys, give each an optional expiry, and revoke one without touching your Firecrawl account. Only a hash of each key is stored.",
  },
  {
    icon: "gauge",
    term: "Rate limits per key",
    detail:
      "Every key is limited to 120 requests per minute by default, so a leaked or looping client cannot burn through your credits unnoticed.",
  },
  {
    icon: "layers",
    term: "Several Cloud keys, one pool",
    detail:
      "Add more than one Firecrawl key and requests are spread across the ones that still have credits. A key that runs out is skipped until credits return.",
  },
  {
    icon: "chart",
    term: "Usage at a glance",
    detail:
      "See requests, errors and average latency for the month, per key, from the gateway's own request log.",
  },
] as const;

const boundaries = [
  "Requests are billed by Firecrawl to your account. The gateway adds no credits of its own.",
  "Requests from your keys go to Firecrawl Cloud only, never to a shared pool.",
  "Request history is kept for 30 days.",
  "Compatibility follows Firecrawl's API; features Firecrawl adds or changes may not be available here yet.",
];
---

<Layout
  title="Firecrawl Gateway — turn websites into clean data without sharing your Firecrawl key"
  description="Firecrawl turns web pages into markdown and structured data. Use your own Firecrawl account through gateway keys you can limit, expire and revoke."
>
  <header class="sticky top-0 z-40 border-b border-white/[0.06] bg-background/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight">
        <img src="/logo.png" alt="" width="28" height="28" class="size-7 rounded-md" />
        Firecrawl Gateway
      </a>
      <nav
        aria-label="Page"
        class="ml-auto hidden items-center gap-1 text-sm text-muted-foreground sm:flex"
      >
        <a href="#what" class="rounded-md px-3 py-2 hover:bg-white/[0.05] hover:text-foreground">
          What it does
        </a>
        <a href="#flow" class="rounded-md px-3 py-2 hover:bg-white/[0.05] hover:text-foreground">
          The gateway
        </a>
        <a href="#how" class="rounded-md px-3 py-2 hover:bg-white/[0.05] hover:text-foreground">
          How it works
        </a>
        <a
          href="#features"
          class="rounded-md px-3 py-2 hover:bg-white/[0.05] hover:text-foreground"
        >
          What you get
        </a>
      </nav>
      <a
        href={portalUrl}
        class="ml-auto inline-flex h-9 items-center rounded-md bg-action px-4 text-sm font-semibold text-white transition-colors hover:bg-action-hover sm:ml-2"
      >
        Sign in
      </a>
    </div>
  </header>

  <main id="main">
    <section class="relative overflow-hidden">
      <div class="grid-texture pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-14 px-5 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
        <div class="fade-up">
          <p class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-surface-2 px-3 py-1 text-xs font-medium text-muted-foreground">
            <span class="size-1.5 rounded-full bg-logo-cyan" aria-hidden="true"></span>
            For people who already use Firecrawl
          </p>
          <h1 class="mt-6 text-[2.5rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-[3.9rem]">
            Turn any website into clean data,
            <span class="bg-gradient-to-r from-logo-cyan to-logo-violet bg-clip-text text-transparent">
              without sharing your key.
            </span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-foreground/85">
            <strong class="font-semibold text-foreground">Firecrawl</strong> reads web pages and
            gives your code or your AI clean markdown and structured data. This gateway sits in
            front of
            <em class="not-italic text-foreground">your own</em> Firecrawl account and gives you API
            keys you can limit, expire and revoke.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={portalUrl}
              class="inline-flex h-12 items-center gap-2 rounded-md bg-action px-6 text-sm font-semibold text-white transition-colors hover:bg-action-hover"
            >
              Sign in to get started
              <Icon name="arrow" class="size-4" />
            </a>
            <a
              href="#what"
              class="inline-flex h-12 items-center rounded-md border border-white/[0.14] px-5 text-sm font-medium transition-colors hover:bg-white/[0.06]"
            >
              What does Firecrawl do?
            </a>
          </div>
        </div>

        <div class="fade-up fade-up-delay">
          <div class="gradient-border shadow-[var(--shadow-modal)]">
            <div class="overflow-hidden bg-surface-1">
              <div class="flex items-center justify-between gap-3 border-b border-white/[0.06] bg-surface-2 px-4 py-2.5">
                <span class="font-mono text-xs text-muted-foreground">1 · You send a URL</span>
                <span class="font-mono text-xs text-logo-text">POST /v2/scrape</span>
              </div>
              <pre class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.7]"><code><span class="text-muted-foreground">$</span> curl -X POST https://<span class="text-logo-text">your-gateway</span>/v2/scrape \
  -H "Authorization: Bearer <span class="text-logo-text">fc_your_gateway_key</span>" \
  -H "Content-Type: application/json" \
  -d '&#123;"url": "https://example.com"&#125;'</code></pre>
              <div class="flex items-center justify-between gap-3 border-y border-white/[0.06] bg-surface-2 px-4 py-2.5">
                <span class="font-mono text-xs text-muted-foreground">2 · You get clean data</span>
                <span class="font-mono text-xs text-muted-foreground">abridged</span>
              </div>
              <pre class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.7] text-muted-foreground"><code>&#123;
  "success": true,
  "data": &#123;
    "markdown": "<span class="text-logo-text"># Example Domain</span>\n\nThis domain is for use in
                 illustrative examples in documents...",
    "metadata": &#123; "title": "Example Domain",
                  "statusCode": 200 &#125;
  &#125;
&#125;</code></pre>
            </div>
          </div>
        </div>
      </div>

      <div class="relative border-y border-white/[0.06] bg-surface-1/70">
        <dl class="mx-auto grid max-w-6xl divide-y divide-white/[0.06] px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {stats.map((stat) => (
            <div class="flex items-center gap-4 py-5 sm:px-6 sm:first:pl-0">
              <dt class="font-mono text-4xl font-semibold tabular-nums bg-gradient-to-br from-logo-cyan to-logo-violet bg-clip-text text-transparent">
                {stat.value}
              </dt>
              <dd class="text-sm leading-snug text-muted-foreground">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="what" class="border-b border-white/[0.06]">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:py-24 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-logo-text">
            What Firecrawl does
          </p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
            Websites in, clean data out.
          </h2>
          <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
            Web pages are messy: scripts, menus, ads, pages that only render in a browser. Firecrawl
            does that work for you and returns content in a shape your code or an LLM can use
            directly.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {firecrawl.map((item) => (
            <li class="rounded-xl border border-white/[0.08] bg-surface-1 p-5 transition-colors hover:border-logo-violet/50">
              <span class="flex size-10 items-center justify-center rounded-lg border border-logo-violet/30 bg-logo-violet/10 text-logo-text">
                <Icon name={item.icon} class="size-5" />
              </span>
              <p class="mt-4 font-mono text-lg font-semibold">{item.verb}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="flow">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <div class="max-w-2xl">
          <p class="font-mono text-xs uppercase tracking-wider text-logo-text">The gateway</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
            One key in every script means one leak spends all your credits.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">
            Anyone holding your Firecrawl key can use all of its credits, and you cannot tell who
            did what. The gateway sits between your code and Firecrawl, so each client gets its own
            key that you can limit and revoke. The work still runs on your account.
          </p>
        </div>
        <ol
          class="mt-12 flex flex-col items-stretch gap-3 md:flex-row md:items-stretch md:gap-0"
          aria-label="Request flow"
        >
          {flow.map((node, index) => (
            <>
              <li
                class:list={[
                  "flex-1 rounded-xl border p-5",
                  node.highlight
                    ? "border-logo-violet/60 bg-surface-2 shadow-[0_0_0_4px_hsl(258_90%_72%/0.08)]"
                    : "border-white/[0.08] bg-surface-1",
                ]}
              >
                <p
                  class:list={[
                    "font-mono text-[11px] uppercase tracking-wider",
                    node.highlight ? "text-logo-text" : "text-muted-foreground",
                  ]}
                >
                  {node.label}
                </p>
                <h3 class="mt-2 text-base font-semibold">{node.title}</h3>
                <ul class="mt-3 grid gap-1.5 text-sm text-muted-foreground">
                  {node.lines.map((line) => (
                    <li class="flex gap-2">
                      <span
                        class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/60"
                        aria-hidden="true"
                      />
                      {line}
                    </li>
                  ))}
                </ul>
              </li>
              {index < flow.length - 1 && (
                <li
                  aria-hidden="true"
                  class="flex items-center justify-center px-3 py-1 text-logo-text md:py-0"
                >
                  <Icon name="arrow" class="size-5 rotate-90 md:rotate-0" />
                </li>
              )}
            </>
          ))}
        </ol>
      </div>
    </section>

    <section id="how" class="border-y border-white/[0.06] bg-surface-1">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <p class="font-mono text-xs uppercase tracking-wider text-logo-text">How it works</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Three steps, about two minutes
        </h2>
        <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
          {steps.map((step, index) => (
            <li class="relative">
              <div class="flex items-center gap-4">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-logo-violet/40 bg-logo-violet/10 font-mono text-base font-semibold text-logo-text">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {index < steps.length - 1 && (
                  <span
                    class="hidden h-px flex-1 bg-gradient-to-r from-logo-violet/50 to-transparent md:block"
                    aria-hidden="true"
                  />
                )}
              </div>
              <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="features">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:py-24 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="font-mono text-xs uppercase tracking-wider text-logo-text">What you get</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            Control, not a new vendor
          </h2>
          <p class="mt-4 max-w-sm text-base leading-relaxed text-muted-foreground">
            A thin layer in front of the Firecrawl account you already pay for. It does not replace
            Firecrawl; it controls who can use your key and shows how it is used.
          </p>
          <a
            href={portalUrl}
            class="mt-6 inline-flex h-10 items-center gap-2 rounded-md border border-white/[0.14] px-4 text-sm font-medium transition-colors hover:bg-white/[0.06]"
          >
            Open the portal
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <dl class="divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {capabilities.map((item) => (
            <div class="grid gap-4 py-6 sm:grid-cols-[3rem_1fr]">
              <div class="flex size-12 items-center justify-center rounded-lg border border-logo-violet/30 bg-logo-violet/10 text-logo-text">
                <Icon name={item.icon} class="size-5" />
              </div>
              <div>
                <dt class="text-base font-semibold">{item.term}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.detail}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="good-to-know" class="border-t border-white/[0.06] bg-surface-1">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <div class="grid gap-8 rounded-2xl border border-white/[0.08] bg-surface-2 p-6 sm:p-8 lg:grid-cols-[0.7fr_1.3fr]">
          <div>
            <span class="flex size-10 items-center justify-center rounded-lg border border-white/[0.1] bg-surface-3 text-muted-foreground">
              <Icon name="info" class="size-5" />
            </span>
            <h2 class="mt-4 text-2xl font-semibold tracking-tight">Good to know</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              The honest limits of what this is.
            </p>
          </div>
          <ul class="grid gap-4 text-sm leading-relaxed text-muted-foreground">
            {boundaries.map((item) => (
              <li class="flex gap-3">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden border-t border-white/[0.06]">
      <div
        class="grid-texture pointer-events-none absolute inset-0 opacity-80"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-6xl px-5 py-20 text-center sm:py-28">
        <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight sm:text-5xl">
          Put your Firecrawl key
          <span class="bg-gradient-to-r from-logo-cyan to-logo-violet bg-clip-text text-transparent">
            behind a gateway.
          </span>
        </h2>
        <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
          Sign in, add your Firecrawl key and create your first gateway key.
        </p>
        <a
          href={portalUrl}
          class="mt-9 inline-flex h-12 items-center gap-2 rounded-md bg-action px-7 text-sm font-semibold text-white transition-colors hover:bg-action-hover"
        >
          Sign in to get started
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/[0.06] bg-surface-1">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2.5">
        <img src="/logo.png" alt="" width="20" height="20" class="size-5 rounded" />
        Firecrawl Gateway is an independent project and is not affiliated with Firecrawl.
      </p>
      <nav aria-label="Footer" class="flex items-center gap-5">
        <a href="#what" class="hover:text-foreground">
          What it does
        </a>
        <a href="#how" class="hover:text-foreground">
          How it works
        </a>
        <a href={portalUrl} class="hover:text-foreground">
          Sign in
        </a>
      </nav>
    </div>
  </footer>
</Layout>
