{
  "name": "firecrawl-gateway",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --env-file=\"$(pwd)/.env\" node_modules/.bin/turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "bun --env-file=\"$(pwd)/.env\" --cwd apps/api prisma generate",
    "db:migrate": "bun --env-file=\"$(pwd)/.env\" --cwd apps/api prisma migrate deploy"
  },
  "lint-staged": {
    "**/*.{cjs,css,html,js,jsx,json,jsonc,md,mdx,mjs,ts,tsx,yaml,yml}": "prettier --write",
    "apps/api/**/*.{cjs,js,mjs,ts}": "./apps/api/node_modules/.bin/eslint --config apps/api/eslint.config.mjs --no-warn-ignored",
    "apps/admin/**/*.{cjs,js,jsx,mjs,ts,tsx}": "./apps/admin/node_modules/.bin/eslint --config apps/admin/eslint.config.js --no-warn-ignored",
    "apps/portal/**/*.{cjs,js,jsx,mjs,ts,tsx}": "./apps/admin/node_modules/.bin/eslint --config apps/portal/eslint.config.js --no-warn-ignored",
    "packages/ui/**/*.{cjs,js,jsx,mjs,ts,tsx}": "./apps/admin/node_modules/.bin/eslint --config packages/ui/eslint.config.js --no-warn-ignored",
    "packages/api-client/**/*.{cjs,js,jsx,mjs,ts,tsx}": "./apps/admin/node_modules/.bin/eslint --config packages/api-client/eslint.config.js --no-warn-ignored"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.6"
  }
}
