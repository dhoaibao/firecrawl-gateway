{
  "name": "firecrawl-gateway-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Firecrawl gateway and admin dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.12.1",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "api:typecheck": "turbo run typecheck --filter=@firecrawl/api",
    "api:test": "turbo run test --filter=@firecrawl/api",
    "api:build": "turbo run build --filter=@firecrawl/api",
    "web:typecheck": "turbo run typecheck --filter=@firecrawl/web",
    "web:lint": "turbo run lint --filter=@firecrawl/web",
    "web:build": "turbo run build --filter=@firecrawl/web",
    "contracts:typecheck": "turbo run typecheck --filter=@firecrawl/contracts",
    "contracts:lint": "turbo run lint --filter=@firecrawl/contracts",
    "contracts:test": "turbo run test --filter=@firecrawl/contracts",
    "contracts:build": "turbo run build --filter=@firecrawl/contracts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
